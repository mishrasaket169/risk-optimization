{"data": [{"TaskID": 1, "TaskName": "Planning & Requirement Analysis", "StartDate": "2026-07-17T02:30:00.000Z", "EndDate": "2026-08-07T11:30:00.000Z", "Duration": 16, "Predecessor": null, "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 1: Project foundation, Indian banking regulatory landscape review, Basel III LCR/NSFR specifications, and capital market microstructure analysis.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 2, "TaskName": "Problem Scope & Literature Survey", "StartDate": "2026-07-17T02:30:00.000Z", "EndDate": "2026-07-28T11:30:00.000Z", "Duration": 8, "Predecessor": "", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Literature review on Indian commercial banking operations, RBI liquidity guidelines, continuous double auction matching engines, and predictive ML for financial distress.</p>", "DurationUnit": "day"}, {"TaskID": 3, "TaskName": "Dataset Selection & Requirement Gathering", "StartDate": "2026-07-29T02:30:00.000Z", "EndDate": "2026-08-07T11:30:00.000Z", "Duration": 8, "Predecessor": "2FS", "resources": [{"resourceId": "Financial Risk Analyst", "resourceName": "Financial Risk Analyst", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>Requirement specifications for synthetic bank profiles (Large, Medium, Small, Distressed), NSE market tick/quote schemas, G-Sec duration ladders, and regulatory reporting boundaries.</p>", "DurationUnit": "day"}, {"TaskID": 4, "TaskName": "Project scope and requirements finalized", "StartDate": "2026-08-07T11:30:00.000Z", "EndDate": "2026-08-07T11:30:00.000Z", "Duration": 0, "Predecessor": "3FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "", "info": "<p>Formal approval of the 30-prompt implementation plan, non-negotiable financial invariants, and synthetic simulation boundaries.</p>", "DurationUnit": "day"}]}, {"TaskID": 5, "TaskName": "System Design", "StartDate": "2026-08-07T02:30:00.000Z", "EndDate": "2026-08-21T11:30:00.000Z", "Duration": 11, "Predecessor": "4FS", "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 2: Complete multi-module software architecture, domain model specification, database schemas, and mathematical formulations for financial invariants.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 6, "TaskName": "System Architecture & UML Modeling", "StartDate": "2026-08-07T02:30:00.000Z", "EndDate": "2026-08-14T11:30:00.000Z", "Duration": 6, "Predecessor": "4FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Architectural design of Java 25 9-submodule Maven reactor, JavaFX desktop application shell, STOMP pub/sub messaging broker, and multi-schema PostgreSQL database layout.</p>", "DurationUnit": "day"}, {"TaskID": 7, "TaskName": "Data Pipeline & Model Selection Planning", "StartDate": "2026-08-14T02:30:00.000Z", "EndDate": "2026-08-21T11:30:00.000Z", "Duration": 6, "Predecessor": "6FS", "resources": [{"resourceId": "Backend Engineer", "resourceName": "Backend Engineer", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>Formulation of double-entry ledger invariant (sum Debits = sum Credits), Banker's rounding Money arithmetic, XGBoost momentum/slippage models, and fallback heuristics.</p>", "DurationUnit": "day"}, {"TaskID": 8, "TaskName": "System design completed", "StartDate": "2026-08-21T11:30:00.000Z", "EndDate": "2026-08-21T11:30:00.000Z", "Duration": 0, "Predecessor": "7FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "", "info": "<p>System design sign-off, frozen database entity schemas, and interface contract specification published in ARCHITECTURE.md.</p>", "DurationUnit": "day"}]}, {"TaskID": 9, "TaskName": "Data Preparation & Synthetic Modeling", "StartDate": "2026-08-21T02:30:00.000Z", "EndDate": "2026-09-11T11:30:00.000Z", "Duration": 16, "Predecessor": "8FS", "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 3: Generation of synthetic Indian banking populations, multi-asset instrument catalogue, and market microstructure datasets.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 10, "TaskName": "Multi-Bank Synthetic Population Generation & Schemas", "StartDate": "2026-08-21T02:30:00.000Z", "EndDate": "2026-09-02T11:30:00.000Z", "Duration": 9, "Predecessor": "8FS", "resources": [{"resourceId": "Backend Engineer", "resourceName": "Backend Engineer", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Flyway migrations and deterministic generator for 4 bank schemas: Large (10,000 customers), Medium (7,500), Small (5,000), Distressed (5,000 with 14.2% NPA ratio), loans, deposits, and ledger accounts.</p>", "DurationUnit": "day"}, {"TaskID": 11, "TaskName": "Financial Instruments Catalogue & Market Data Feature Engineering", "StartDate": "2026-09-03T02:30:00.000Z", "EndDate": "2026-09-11T11:30:00.000Z", "Duration": 7, "Predecessor": "10FS", "resources": [{"resourceId": "Financial Risk Analyst", "resourceName": "Financial Risk Analyst", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>Catalogue of equities, G-Secs, T-Bills, corporate bonds. Ingestion controls for historical NSE OHLCV, Level-2 order book depth queues, and feature pipeline construction.</p>", "DurationUnit": "day"}, {"TaskID": 12, "TaskName": "Dataset ready for training", "StartDate": "2026-09-11T11:30:00.000Z", "EndDate": "2026-09-11T11:30:00.000Z", "Duration": 0, "Predecessor": "11FS", "resources": [{"resourceId": "Data Scientist", "resourceName": "Data Scientist", "unit": 100}], "Progress": 100, "color": "", "info": "<p>Validation of synthetic population integrity, reproducible seed verification, and training feature matrix export ready for ML modeling.</p>", "DurationUnit": "day"}]}, {"TaskID": 13, "TaskName": "Model Development", "StartDate": "2026-09-11T02:30:00.000Z", "EndDate": "2026-09-25T11:30:00.000Z", "Duration": 11, "Predecessor": "12FS", "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 4: Training, calibration, and microservice packaging of the two XGBoost machine learning models.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 14, "TaskName": "Model 1: Short-Horizon Equity Momentum Architecture", "StartDate": "2026-09-11T02:30:00.000Z", "EndDate": "2026-09-18T11:30:00.000Z", "Duration": 6, "Predecessor": "12FS", "resources": [{"resourceId": "Data Scientist", "resourceName": "Data Scientist", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Train XGBoost classifier on OHLCV features, lag returns, moving averages, and volatility spreads to predict short-horizon price momentum. Packaging into inference_server.py.</p>", "DurationUnit": "day"}, {"TaskID": 15, "TaskName": "Model 2: Execution Cost & Liquidity Slippage Model Training", "StartDate": "2026-09-18T02:30:00.000Z", "EndDate": "2026-09-25T11:30:00.000Z", "Duration": 6, "Predecessor": "14FS", "resources": [{"resourceId": "Data Scientist", "resourceName": "Data Scientist", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>Train XGBoost regressor on order book depth, quote spread, and fill rates to forecast slippage and execution costs. Deterministic Square-Root Law fallback adapter integration.</p>", "DurationUnit": "day"}, {"TaskID": 16, "TaskName": "Baseline model trained successfully", "StartDate": "2026-09-25T11:30:00.000Z", "EndDate": "2026-09-25T11:30:00.000Z", "Duration": 0, "Predecessor": "15FS", "resources": [{"resourceId": "Data Scientist", "resourceName": "Data Scientist", "unit": 100}], "Progress": 100, "color": "", "info": "<p>Model artifacts saved, model cards compiled (MODEL_CARD_MODEL1.md, MODEL_CARD_MODEL2.md), and Python REST endpoint validated on port 8082.</p>", "DurationUnit": "day"}]}, {"TaskID": 17, "TaskName": "Evaluation & Testing", "StartDate": "2026-09-25T02:30:00.000Z", "EndDate": "2026-10-09T11:30:00.000Z", "Duration": 11, "Predecessor": "16FS", "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 5: Automated test suite execution, financial invariant verification, model out-of-sample evaluation, and benchmark comparison.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 18, "TaskName": "Model Evaluation & Benchmark Comparison", "StartDate": "2026-09-25T02:30:00.000Z", "EndDate": "2026-10-02T11:30:00.000Z", "Duration": 6, "Predecessor": "16FS", "resources": [{"resourceId": "Financial Risk Analyst", "resourceName": "Financial Risk Analyst", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Out-of-sample validation of Model 1 (directional accuracy) and Model 2 (RMSE vs Square-Root law). 1-day 99% Parametric VaR backtesting, HQLA classification, and LCR estimation.</p>", "DurationUnit": "day"}, {"TaskID": 19, "TaskName": "System Testing & Error Analysis", "StartDate": "2026-10-02T02:30:00.000Z", "EndDate": "2026-10-09T11:30:00.000Z", "Duration": 6, "Predecessor": "18FS", "resources": [{"resourceId": "Backend Engineer", "resourceName": "Backend Engineer", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>42 backend automated tests covering double-entry balance enforcement, continuous matching throughput (>37,500 orders/sec), STOMP idempotency, and Maker/Checker authorization.</p>", "DurationUnit": "day"}, {"TaskID": 20, "TaskName": "Final baseline model validated", "StartDate": "2026-10-09T11:30:00.000Z", "EndDate": "2026-10-09T11:30:00.000Z", "Duration": 0, "Predecessor": "19FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "", "info": "<p>100% test pass rate across all 9 backend modules with 0 failures and 0 errors. All financial invariants mathematically verified.</p>", "DurationUnit": "day"}]}, {"TaskID": 21, "TaskName": "Implementation & Deployment (30% Deliverables)", "StartDate": "2026-10-02T02:30:00.000Z", "EndDate": "2026-10-16T11:30:00.000Z", "Duration": 11, "Predecessor": "19FS", "resources": [], "Progress": 100, "color": "", "info": "<p>Phase 6: Complete end-to-end integration of backend reactor, JavaFX desktop application, ML microservice, real-time stress testing, and 30% milestone release handover.</p>", "DurationUnit": "day", "subtasks": [{"TaskID": 22, "TaskName": "API Backend & Frontend UI Integration", "StartDate": "2026-10-02T02:30:00.000Z", "EndDate": "2026-10-12T11:30:00.000Z", "Duration": 7, "Predecessor": "19FS", "resources": [{"resourceId": "Frontend Engineer", "resourceName": "Frontend Engineer", "unit": 100}], "Progress": 100, "color": "121", "info": "<p>Integration of JavaFX desktop UI with backend engine via STOMP and in-process DTOs. Interactive views for Bank Simulator, Exchange Simulator, and Liquidity Risk Optimizer with dark financial theme.</p>", "DurationUnit": "day"}, {"TaskID": 23, "TaskName": "Real-time Verification & 30% Progress Report", "StartDate": "2026-10-12T02:30:00.000Z", "EndDate": "2026-10-16T11:30:00.000Z", "Duration": 5, "Predecessor": "22FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "211", "info": "<p>Real-time macro crash scenario simulation (-30% equity, +150 bps yield), 7-day quote retention pruning, Windows/Linux startup runbooks, and 30% milestone traceability report.</p>", "DurationUnit": "day"}, {"TaskID": 24, "TaskName": "Project completed and demonstrated (30% Milestone)", "StartDate": "2026-10-16T11:30:00.000Z", "EndDate": "2026-10-16T11:30:00.000Z", "Duration": 0, "Predecessor": "23FS", "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect", "unit": 100}], "Progress": 100, "color": "", "info": "<p>30% Milestone deliverables successfully completed, verified, and demonstrated. Comprehensive RELEASE_HANDOVER.md delivered.</p>", "DurationUnit": "day"}]}], "resources": [{"resourceId": "Lead Systems Architect", "resourceName": "Lead Systems Architect"}, {"resourceId": "Financial Risk Analyst", "resourceName": "Financial Risk Analyst"}, {"resourceId": "Backend Engineer", "resourceName": "Backend Engineer"}, {"resourceId": "Data Scientist", "resourceName": "Data Scientist"}, {"resourceId": "Frontend Engineer", "resourceName": "Frontend Engineer"}], "projectStartDate": "2026-07-17T02:30:00.000Z", "projectEndDate": "2026-10-16T11:30:00.000Z", "advanced": {"columns": [{"name": "Task ID", "width": "70", "show": true}, {"name": "Task Name", "width": "350", "show": true}, {"name": "Start Date", "width": "130", "show": false}, {"name": "End Date", "width": "130", "show": false}, {"name": "Duration", "width": "130", "show": false}, {"name": "Progress %", "width": "150", "show": false}, {"name": "Dependency", "width": "150", "show": false}, {"name": "Resources", "width": "200", "show": false}, {"name": "Color", "width": "100", "show": false}, {"name": "Notes", "width": "200", "show": false}], "zoomLevel": 0, "timezone": "Asia/Calcutta", "timezoneOffset": -330, "dependencyConflict": "Add Offset to Dependency", "dateFormat": "yyyy-MM-dd", "timeFormat": "HH:mm", "firstDayOfWeek": 0, "workWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "workTime": [{"from": 8, "to": 12}, {"from": 13, "to": 17}], "holidays": []}}