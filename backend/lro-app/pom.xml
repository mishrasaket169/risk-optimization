<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lro</groupId>
        <artifactId>lro-backend-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lro-app</artifactId>
    <packaging>jar</packaging>
    <name>LRO Backend Application Runner &amp; Integration Test Suite</name>

    <dependencies>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-bank-services</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-exchange-services</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-ml-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lro</groupId>
            <artifactId>lro-orchestration</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.lro.app.BackendLauncher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
